<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GroupFold</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>groupfold</ToolCommandName>
    <PackageId>GroupFold.Tool</PackageId>
    <Version>0.1.0</Version>
    <Authors>alirezaRanjbar4</Authors>
    <Description>Offline group-preserving, class-aware cross-validation fold artifacts for labeled JSONL datasets.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/alirezaRanjbar4/groupfold</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alirezaRanjbar4/groupfold</PackageProjectUrl>
    <PackageTags>dotnet;csharp;machine-learning;cross-validation;dataset;stratification</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md;../../LICENSE;../../CONTRIBUTING.md;../../ROADMAP.md;../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/*.md" Pack="true" PackagePath="docs/" />
    <None Include="../../examples/*.jsonl;../../examples/README.md" Pack="true" PackagePath="examples/" />
  </ItemGroup>
</Project>
